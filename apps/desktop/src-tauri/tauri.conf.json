{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskCrate",
  "version": "0.1.0",
  "identifier": "com.taskmanager.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TaskCrate",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "capture",
        "title": "TaskCrate 速记",
        "url": "index.html?capture=1",
        "width": 520,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "TaskCrate",
    "shortDescription": "TaskCrate：本地优先的轻量任务管理工具",
    "longDescription": "TaskCrate：支持列表、看板、筛选、提醒、回收站与自动备份的桌面任务管理应用。",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
